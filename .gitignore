# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# slopbro runtime & agent temp
/agent-tools/
*.key
__pycache__/
*.pyc
/dist/


# Real app artwork pulled off the TV for local preview only; apply.sh copies
# these onto the device at deploy time and they are not part of the ipk.
launcher/icons/
uploads/

# Background video: large binary, shipped to the TV at deploy time.
wwwroot/bg.mp4
launcher/bg.mp4

# Generated artifacts, all reproducible from source in tools/:
#   build_banner.py -> home-banner*.png
#   build_launcher_ipk.py -> wolfdenos.ipk
wwwroot/home-banner*.png
wwwroot/wolfdenos.ipk

# Patched copy of LG's proprietary Flutter library. Regenerate it with
#   python3 tools/patch_libapp.py uploads/libapp.so -o wwwroot/libapp.so
# after pulling the stock library off your own TV. Deliberately NOT committed:
# it is a derivative of LG's copyrighted binary and redistributing it is a
# different matter from patching it on a device you own.
wwwroot/libapp.so

# Home-screen overlay: the ipk is generated by tools/build_overlay_ipk.py, and
# the seasonal artwork is third-party and large. apply.sh ships both to the TV.
wwwroot/wolfdenos-overlay.ipk
wwwroot/season-*.jpg
wwwroot/season-*.mp4
overlay/season.jpg
overlay/season.mp4

# QML home: the ipk is generated by tools/build_ipk.py; the live background
# and its idle still are large third-party media shipped at deploy time.
wwwroot/wolfdenos-qmlhome.ipk
wwwroot/home-bg.mp4
wwwroot/home-bg-still.jpg
qmlhome/home-bg.mp4
qmlhome/home-bg-still.jpg
